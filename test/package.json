{
  "name": "finally-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for the FinAlly trading workstation.",
  "scripts": {
    "pretest": "node scripts/prepare.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
